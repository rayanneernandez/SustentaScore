# Copie este arquivo para ".env" (mesma pasta) e preencha com os valores do
# seu projeto Supabase: Project Settings → API (no painel do Supabase).
#
# VITE_SUPABASE_URL     -> "Project URL" (ex: https://abcdefgh.supabase.co)
# VITE_SUPABASE_ANON_KEY -> "anon public" key (a chave pública, não a "service_role")
#
# O arquivo ".env" não deve ir para o Git (já está no .gitignore) — cada
# pessoa/ambiente configura o seu.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
